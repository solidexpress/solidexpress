; Engine configuration file.

config_version=5

[application]

config/name="SolidExpress"
config/icon="res://icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
# CAD-style: only present frames when something changes (idle GPU near zero).
run/low_processor_mode=true
# Cap active redraw ~60 FPS while orbiting / dragging (1000000/16666).
run/low_processor_mode_sleep_usec=16666

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
# No window/stretch — UI chrome stays DPI-scaled (UiScale), independent of
# window size; only the 3D viewport grows/shrinks on resize.

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
