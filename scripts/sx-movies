#!/usr/bin/env bash
# sx-movies — rebuild UI demo movies from game/tests/ui_movie_manifest.json
#
# Usage:
#   scripts/sx-movies              # render all enabled films → dist/movies/
#   scripts/sx-movies all          # same
#   scripts/sx-movies release      # curated website entries only
#   scripts/sx-movies list         # show manifest entries
#   scripts/sx-movies one ID         # render single film
#
# Output: ID.webm (VP9) + ID.vtt (closed captions).
#
# Capture path: Godot --write-movie ID.sxpipe → SxFfmpegMovieWriter (GDExtension)
# pipes raw RGB24 frames to ffmpeg stdin (libvpx-vp9). No AVI/MJPEG scratch file.
#
# Needs a GPU display driver (not --headless). Film window is minimized by default
# (SX_TEST_WINDOW=onscreen to watch). Optional: SX_MOVIES_XVFB=1 with xvfb-run.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GODOT="${GODOT:-$ROOT/tools/godot/godot}"
GAME="$ROOT/game"
MANIFEST="$GAME/tests/ui_movie_manifest.json"
OUT="${SX_MOVIES_OUT:-$ROOT/dist/movies}"
# FPS is a single source of truth: keep in sync with FilmPresentation.FPS.
FPS="30"

if [[ ! -x "$GODOT" ]]; then
  echo "sx-movies: Godot not found at $GODOT" >&2
  exit 1
fi
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "sx-movies: ffmpeg required (SxFfmpegMovieWriter pipes raw frames to it)" >&2
  exit 1
fi

mkdir -p "$OUT"

"$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true

godot_cmd() {
  if [[ "${SX_MOVIES_XVFB:-0}" == "1" ]] && command -v xvfb-run >/dev/null 2>&1; then
    xvfb-run -a -s "-screen 0 1920x1080x24" "$GODOT" "$@"
  else
    "$GODOT" "$@"
  fi
}

list_entries() {
  python3 - "$MANIFEST" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
for e in data:
    en = e.get("enabled", True)
    mark = "on " if en else "off"
    print(f"{mark}  {e['id']:24s}  {e.get('title', '')}")
PY
}

enabled_rows() {
  python3 - "$MANIFEST" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
for e in data:
    if not e.get("enabled", True):
        continue
    q = int(e.get("quit_after", 1200))
    print(f"{e['id']}\t{q}")
PY
}

website_rows() {
  python3 - "$MANIFEST" "$ROOT/tools/website_demos.py" <<'PY'
import json, runpy, sys
manifest_path, helper = sys.argv[1], sys.argv[2]
mod = runpy.run_path(helper)
by_id = {e["id"]: e for e in json.load(open(manifest_path))}
for row in mod["curated"]():
    e = by_id.get(row["id"], {})
    q = int(e.get("quit_after", 1200))
    print(f"{row['id']}\t{q}")
PY
}

# Rewrite Cues so ffprobe duration matches decoded length (stdin VP9 often
# leaves a too-long duration after Godot closes the pipe).
remux_cues() {
  local webm="$1"
  local tmp="${webm}.cues.webm"
  if ! ffmpeg -y -loglevel error -i "$webm" -c copy -avoid_negative_ts make_zero "$tmp" </dev/null; then
    rm -f "$tmp"
    echo "sx-movies: warning: cue remux failed for $webm" >&2
    return 0
  fi
  mv -f "$tmp" "$webm"
}

mux_vtt_if_present() {
  local webm="$1"
  local vtt="$2"
  if [[ ! -f "$vtt" ]] || [[ ! -s "$vtt" ]] || [[ ! -f "$webm" ]]; then
    return 0
  fi
  local tmp="${webm}.mux.webm"
  ffmpeg -y -loglevel error \
    -i "$webm" -i "$vtt" \
    -map 0:v:0 -map 1:0 \
    -c:v copy -c:s webvtt \
    "$tmp" </dev/null
  mv -f "$tmp" "$webm"
}

render_one() {
  local id="$1"
  local quit_after="$2"
  local pipe="$OUT/${id}.sxpipe"
  local webm="$OUT/${id}.webm"
  local vtt="$OUT/${id}.vtt"
  local log="$OUT/${id}.log"
  local pipe_abs webm_abs vtt_abs log_abs
  pipe_abs="$(cd "$(dirname "$pipe")" && pwd)/$(basename "$pipe")"
  webm_abs="$(cd "$(dirname "$webm")" && pwd)/$(basename "$webm")"
  vtt_abs="$(cd "$(dirname "$vtt")" && pwd)/$(basename "$vtt")"
  log_abs="$(cd "$(dirname "$log")" && pwd)/$(basename "$log")"
  rm -f "$pipe_abs" "$webm_abs" "$OUT/${id}.avi" "$log_abs"

  # quit_after is a safety ceiling only; the film script quit()s when done.
  echo "=== sx-movies: $id → $webm_abs (raw RGB24 → ffmpeg, max $quit_after frames @ ${FPS}fps)"
  set +e
  godot_cmd --path "$GAME" \
    --write-movie "$pipe_abs" \
    --fixed-fps "$FPS" \
    --disable-vsync \
    --quit-after "$quit_after" \
    --script tests/movie_maker_run_one.gd -- \
      --film-id "$id" --movie-capture 1 --captions-out "$vtt_abs" \
    2>&1 | tee "$log_abs"
  godot_ec=${PIPESTATUS[0]}
  set -e
  rm -f "$pipe_abs" # marker path only; writer never keeps it as a media file

  if [[ -f "$log_abs" ]] && grep -q "SCRIPT ERROR" "$log_abs"; then
    echo "sx-movies: SCRIPT ERROR in $id (see $log_abs)" >&2
    return 1
  fi
  if [[ ! -f "$webm_abs" ]] || [[ $(stat -c%s "$webm_abs" 2>/dev/null || echo 0) -lt 4096 ]]; then
    echo "sx-movies: Godot/ffmpeg failed (exit $godot_ec); missing or tiny $webm_abs" >&2
    return 1
  fi
  if [[ $godot_ec -ne 0 ]]; then
    echo "sx-movies: Godot exited $godot_ec after writing $webm_abs" >&2
    return 1
  fi

  remux_cues "$webm_abs"
  # Captions are burned into the frames; muxing the .vtt doubled them in players
  # and its process-clock timing doubled the reported length.
  # mux_vtt_if_present "$webm_abs" "$vtt_abs"
  remux_cues "$webm_abs"

  if [[ -f "$vtt_abs" ]]; then
    echo "    vtt: $vtt_abs"
  else
    echo "sx-movies: warning: no captions at $vtt_abs" >&2
  fi
  echo "    webm: $webm_abs"
}

preflight() {
  echo "=== sx-movies: preflight GDExtension + film caption tests"
  if ! godot_cmd --headless --path "$GAME" --script tests/preflight_sxcore.gd; then
    echo "sx-movies: preflight failed (libsxcore / main.gd did not load)" >&2
    exit 1
  fi
  if ! godot_cmd --headless --path "$GAME" --script tests/run_film_caption_tests.gd; then
    echo "sx-movies: preflight failed (run_film_caption_tests.gd)" >&2
    exit 1
  fi
}

render_loop() {
  local rows_fn="$1"
  local fails=()
  while IFS=$'\t' read -r id quit_after <&3; do
    [[ -z "$id" ]] && continue
    if ! render_one "$id" "$quit_after"; then
      echo "sx-movies: FAILED $id" >&2
      fails+=("$id")
    fi
  done 3< <("$rows_fn")
  if [[ ${#fails[@]} -gt 0 ]]; then
    echo "sx-movies: failures: ${fails[*]}" >&2
    exit 1
  fi
  echo "sx-movies: done → $OUT"
}

cmd="${1:-all}"
case "$cmd" in
  list)
    list_entries
    ;;
  one)
    shift
    id="${1:?usage: sx-movies one FILM_ID}"
    quit_after="$(python3 - "$MANIFEST" "$id" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
for e in data:
    if e["id"] == sys.argv[2]:
        print(int(e.get("quit_after", 1200)))
        break
else:
    sys.exit(1)
PY
)"
    render_one "$id" "$quit_after"
    ;;
  all)
    preflight
    render_loop enabled_rows
    ;;
  release)
    preflight
    render_loop website_rows
    ;;
  *)
    echo "usage: sx-movies [all|release|list|one FILM_ID]" >&2
    exit 1
    ;;
esac
