#!/usr/bin/env python3
"""Fail if the marketing site would show a demo whose WebM is missing.

Hard rule: a play button is only allowed for a film that has
  1. a poster PNG in website/assets/screenshots/<id>.png (or $SX_POSTER_DIR)
  2. an entry in website/assets/published-demos.json
  3. a .webm on the demo-movies Release (HEAD 200), unless --offline

Curated rows come from tools/website_demos.py (features page = all curated,
homepage = the `website.home` tier).
HTML must not hardcode data-demo= or /demo-movies/<id>.webm for unpublished ids.
"""
from __future__ import annotations

import argparse
import json
import os
import time
import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TOOLS = ROOT / "tools"
if str(TOOLS) not in sys.path:
    sys.path.insert(0, str(TOOLS))
import website_demos  # noqa: E402
SITE = ROOT / "website"
CATALOG_PATH = SITE / "assets" / "demo-catalog.json"
PUBLISHED_PATH = SITE / "assets" / "published-demos.json"
SHOTS = website_demos.poster_dir()
MANIFEST_GAME = ROOT / "game" / "tests" / "ui_movie_manifest.json"
MANIFEST_SITE = SITE / "assets" / "ui_movie_manifest.json"
DEFAULT_BASE = (
    "https://github.com/solidexpress/solidexpress/"
    "releases/download/demo-movies/"
)

DATA_DEMO_RE = re.compile(r'data-demo="([A-Za-z0-9_]+)"')
WEBM_URL_RE = re.compile(
    r"releases/download/demo-movies/([A-Za-z0-9_]+)\.webm"
)


def load_json(path: Path):
    return json.loads(path.read_text())


def fail(errors: list[str]) -> int:
    for e in errors:
        print(f"sx-check-website-demos: {e}", file=sys.stderr)
    return 1 if errors else 0


def head_ok(url: str, timeout: float) -> bool:
    """Prove a Release download URL exists (CDN often lags the API listing)."""
    # Prefer a tiny ranged GET: GitHub's releases/download HEAD→CDN path is
    # flaky right after upload (405/404), while Range GET follows the 302.
    get = urllib.request.Request(url, headers={"Range": "bytes=0-64"})
    try:
        with urllib.request.urlopen(get, timeout=timeout) as resp:
            return 200 <= resp.status < 400
    except urllib.error.HTTPError as exc:
        if exc.code in (403, 405):
            req = urllib.request.Request(url, method="HEAD")
            try:
                with urllib.request.urlopen(req, timeout=timeout) as resp:
                    return 200 <= resp.status < 400
            except urllib.error.HTTPError:
                return False
        return False
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def _api_headers() -> dict[str, str]:
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "sx-check-website-demos",
        "Cache-Control": "no-cache",
    }
    # Unauthenticated calls share a 60/hr per-IP limit on CI runners and can
    # be served stale; use the job token when one is present.
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    return headers


def _get_json(url: str, timeout: float):
    req = urllib.request.Request(url, headers=_api_headers())
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode())


def _gh_release_asset_names(repo: str, tag: str) -> set[str] | None:
    """List Release assets via `gh api --paginate` (same path as sx-publish)."""
    import shutil
    import subprocess

    if not shutil.which("gh"):
        return None
    try:
        rel = subprocess.run(
            ["gh", "api", f"repos/{repo}/releases/tags/{tag}", "--jq", ".id"],
            check=True,
            capture_output=True,
            text=True,
            timeout=60,
        )
        release_id = rel.stdout.strip()
        if not release_id.isdigit():
            return None
        listed = subprocess.run(
            [
                "gh",
                "api",
                f"repos/{repo}/releases/{release_id}/assets?per_page=100",
                "--paginate",
                "--jq",
                ".[].name",
            ],
            check=True,
            capture_output=True,
            text=True,
            timeout=120,
        )
        return {n for n in listed.stdout.splitlines() if n}
    except (subprocess.SubprocessError, OSError, ValueError):
        return None


def release_asset_names(api_url: str, timeout: float) -> set[str] | None:
    """Return asset filenames from the demo-movies Release, or None on failure.

    Prefer `gh api --paginate` when available (matches sx-publish-demo-movies).
    Fall back to the Releases API with explicit pagination so a large Release
    is never judged from a truncated embedded list alone.
    """
    # api_url like .../repos/owner/repo/releases/tags/demo-movies
    parts = api_url.rstrip("/").split("/")
    if len(parts) >= 4 and parts[-2] == "tags":
        tag = parts[-1]
        # .../repos/{owner}/{repo}/releases/tags/{tag}
        try:
            repo_idx = parts.index("repos")
            repo = f"{parts[repo_idx + 1]}/{parts[repo_idx + 2]}"
            via_gh = _gh_release_asset_names(repo, tag)
            if via_gh is not None:
                return via_gh
        except (ValueError, IndexError):
            pass
    try:
        data = _get_json(api_url, timeout)
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
        return None
    names = {str(a.get("name", "")) for a in (data.get("assets") or []) if isinstance(a, dict)}
    assets_url = data.get("assets_url")
    if assets_url:
        paged: set[str] = set()
        page = 1
        try:
            while True:
                batch = _get_json(f"{assets_url}?per_page=100&page={page}", timeout)
                if not isinstance(batch, list) or not batch:
                    break
                paged.update(str(a.get("name", "")) for a in batch if isinstance(a, dict))
                if len(batch) < 100:
                    break
                page += 1
            if paged:
                names = paged  # prefer full paginated list over truncated embed
        except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError):
            pass
    return names


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--offline",
        action="store_true",
        help="skip live Release HEAD checks (posters + catalog only)",
    )
    parser.add_argument("--timeout", type=float, default=20.0)
    args = parser.parse_args()
    errors: list[str] = []

    if not CATALOG_PATH.is_file():
        return fail([f"missing {CATALOG_PATH}"])
    if not PUBLISHED_PATH.is_file():
        return fail([f"missing {PUBLISHED_PATH}"])

    stray_exts = {".webm", ".mp4", ".avi", ".mov", ".vtt"}
    for tree in (SITE, ROOT / "docs"):
        if not tree.is_dir():
            continue
        for p in tree.rglob("*"):
            if p.is_file() and p.suffix.lower() in stray_exts:
                errors.append(
                    f"video/caption file in git tree {p.relative_to(ROOT)} — "
                    "WebMs live only on the Pages-repo demo-movies Release"
                )

    catalog = load_json(CATALOG_PATH)
    published = load_json(PUBLISHED_PATH)
    errors.extend(website_demos.validate_curated(published=published, catalog=catalog))
    if not isinstance(published, list) or not published:
        errors.append("published-demos.json must be a non-empty JSON array of ids")
        return fail(errors)
    published_ids = [str(x) for x in published]
    published_set = set(published_ids)
    featured = catalog.get("featured") or []
    featured_ids = [str(e.get("id", "")) for e in featured if isinstance(e, dict)]
    if not featured_ids:
        errors.append("demo-catalog.json featured list is empty")

    for pid in published_ids:
        poster = SHOTS / f"{pid}.png"
        if not poster.is_file() or poster.stat().st_size < 256:
            errors.append(f"published {pid!r} has no poster at {poster}")

    extra_posters = sorted(
        p.stem
        for p in SHOTS.glob("*.png")
        if p.stem not in published_set
    )
    # Extra posters are OK (unused stills) — but a playable card must not
    # reference them. Hardcoded HTML is checked below.

    html_ids: set[str] = set()
    for html in sorted(SITE.glob("*.html")):
        text = html.read_text()
        html_ids.update(DATA_DEMO_RE.findall(text))
        html_ids.update(WEBM_URL_RE.findall(text))
    for hid in sorted(html_ids):
        if hid not in published_set:
            errors.append(
                f"HTML references unpublished demo {hid!r} — "
                "render cards from demo.js ∩ published-demos.json instead"
            )

    if MANIFEST_SITE.is_file() and MANIFEST_GAME.is_file():
        site_ids = {e["id"] for e in load_json(MANIFEST_SITE) if e.get("enabled", True)}
        game_ids = {e["id"] for e in load_json(MANIFEST_GAME) if e.get("enabled", True)}
        missing = sorted(published_set - game_ids)
        for mid in missing:
            errors.append(
                f"published {mid!r} is not an enabled film in game/tests/ui_movie_manifest.json"
            )
        stale = sorted(site_ids - game_ids)
        if stale:
            errors.append(
                "website/assets/ui_movie_manifest.json is stale vs the game manifest "
                f"(extra: {', '.join(stale)}). Run scripts/sx-sync-website."
            )

    demo = catalog.get("demo_release") or {}
    base = str(demo.get("base") or DEFAULT_BASE)
    api = str(
        demo.get("api")
        or "https://api.github.com/repos/solidexpress/solidexpress/releases/tags/demo-movies"
    )
    if not args.offline:
        # Fresh uploads can lag on some API replicas / CDN edges (runs
        # 38918525777 + 38925835622 listed 24/37 for many minutes while another
        # client already saw all 37). Prefer a full listing; if short, prove
        # each WebM via ranged GET before failing.
        want = {pid + ".webm" for pid in published_ids}
        names = release_asset_names(api, args.timeout)
        for _ in range(20):
            if names is not None and want <= names:
                break
            time.sleep(15)
            names = release_asset_names(api, args.timeout)
        missing = sorted(want - (names or set())) if names is not None else list(want)
        if missing:
            print(
                f"sx-check-website-demos: listing incomplete "
                f"({0 if names is None else len(names)} assets); "
                f"probing downloads for {len(missing)} WebMs",
                flush=True,
            )
        for asset in missing:
            url = base + asset
            ok = False
            for _ in range(30):
                if head_ok(url, args.timeout):
                    ok = True
                    break
                time.sleep(10)
            if not ok:
                n = "unreachable" if names is None else f"listed {len(names)} assets via API"
                errors.append(f"Release WebM missing on demo-movies tag: {asset} ({n})")

    if errors:
        return fail(errors)
    print(
        f"sx-check-website-demos: ok — {len(featured_ids)} featured, "
        f"{len(published_ids)} published"
        + (" (offline)" if args.offline else "")
    )
    if extra_posters:
        print("  unused posters (not published): " + ", ".join(extra_posters))
    return 0


if __name__ == "__main__":
    sys.exit(main())
