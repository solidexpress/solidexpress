#!/usr/bin/env bash
# sx-publish-demo-movies — sync UI films to the marketing site without committing WebMs.
#
# Workflow:
#   1. make movies / scripts/sx-movies release
#   2. scripts/sx-publish-demo-movies      # curated set only (no ids)
#
# No IDs: publish the curated website set, delete stale non-curated Release
# assets, regenerate published-demos.json + demo-catalog featured from
# tools/website_demos.py (single source of truth).
#
# With IDs: require $SX_MOVIES_OUT/<id>.webm; extract poster; upload those
# assets; still regenerate JSON from the curated set.
# --dry-run prints those actions and writes nothing.
#
# Env overrides:
#   SX_MOVIES_OUT          default: <repo>/dist/movies
#   SX_DEMO_RELEASE_REPO   default: solidexpress/solidexpress
#   SX_DEMO_RELEASE_TAG    default: demo-movies
#   SX_SKIP_UPLOAD         if set, skip gh release upload
#   SX_PUBLISHED_JSON      default: <repo>/website/assets/published-demos.json
#   SX_CATALOG_JSON        default: <repo>/website/assets/demo-catalog.json
#   SX_POSTER_DIR          default: <repo>/website/assets/screenshots
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${SX_MOVIES_OUT:-$ROOT/dist/movies}"
REPO="${SX_DEMO_RELEASE_REPO:-solidexpress/solidexpress}"
TAG="${SX_DEMO_RELEASE_TAG:-demo-movies}"
MANIFEST="$ROOT/game/tests/ui_movie_manifest.json"
HELPER="$ROOT/tools/website_demos.py"
PUBLISHED="${SX_PUBLISHED_JSON:-$ROOT/website/assets/published-demos.json}"
CATALOG="${SX_CATALOG_JSON:-$ROOT/website/assets/demo-catalog.json}"
CANON_SHOTS="$ROOT/website/assets/screenshots"
SHOTS="${SX_POSTER_DIR:-$CANON_SHOTS}"

DRY_RUN=0
FEATURE=0
CLI_IDS=0
IDS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --feature) FEATURE=1; shift ;;
    --) shift; break ;;
    -*)
      echo "sx-publish-demo-movies: unknown flag $1" >&2
      exit 2
      ;;
    *) IDS+=("$1"); CLI_IDS=1; shift ;;
  esac
done
while [[ $# -gt 0 ]]; do
  IDS+=("$1"); CLI_IDS=1; shift
done

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "sx-publish-demo-movies: ffmpeg required" >&2
  exit 1
fi
if [[ "$DRY_RUN" -eq 0 && "${SX_SKIP_UPLOAD:-}" == "" ]] && ! command -v gh >/dev/null 2>&1; then
  echo "sx-publish-demo-movies: gh CLI required" >&2
  exit 1
fi
if [[ ! -f "$MANIFEST" ]]; then
  echo "sx-publish-demo-movies: missing $MANIFEST" >&2
  exit 1
fi
if [[ ! -f "$HELPER" ]]; then
  echo "sx-publish-demo-movies: missing $HELPER" >&2
  exit 1
fi

if [[ ${#IDS[@]} -eq 0 ]]; then
  mapfile -t IDS < <(python3 "$HELPER" ids)
  CLI_IDS=0
fi

if [[ ${#IDS[@]} -eq 0 ]]; then
  echo "sx-publish-demo-movies: no films to publish" >&2
  exit 1
fi

mkdir -p "$SHOTS"

assets=()
for id in "${IDS[@]}"; do
  webm="$OUT/${id}.webm"
  vtt="$OUT/${id}.vtt"
  if [[ ! -f "$webm" ]]; then
    echo "sx-publish-demo-movies: missing $webm (run make movies first)" >&2
    exit 1
  fi
  poster="$SHOTS/${id}.png"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "dry-run poster: $id → $poster"
  else
    echo "poster: $id → $poster"
    rm -f "$poster"
    # -sseof -0.1 can land past the last decodable frame and write nothing
    # (exit 0). Fall back to earlier seeks, then the first frame.
    for seek in "-sseof -0.1" "-sseof -1" "-sseof -3" ""; do
      # shellcheck disable=SC2086
      ffmpeg -y -loglevel error $seek -i "$webm" -frames:v 1 "$poster" </dev/null || true
      [[ -s "$poster" ]] && break
      rm -f "$poster"
    done
    if [[ ! -s "$poster" ]]; then
      echo "sx-publish-demo-movies: warning: could not extract poster for $id; skipping poster" >&2
    fi
  fi
  assets+=("$webm")
  if [[ "$DRY_RUN" -eq 1 || -s "$poster" ]]; then
    assets+=("$poster")
  fi
  if [[ -f "$vtt" ]]; then
    assets+=("$vtt")
  fi
done
assets+=("$MANIFEST")

curated_ids() {
  python3 "$HELPER" ids
}

emit_json() {
  python3 "$HELPER" emit --published "$PUBLISHED" --catalog "$CATALOG"
}

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "dry-run upload ${#assets[@]} assets to $REPO@$TAG: ${assets[*]}"
  echo "dry-run emit curated published-demos + demo-catalog featured (append ${IDS[*]})"
  echo "dry-run: no gh call, no file change"
  exit 0
fi

if [[ "${SX_SKIP_UPLOAD:-}" == "" ]]; then
  if gh release view "$TAG" -R "$REPO" >/dev/null 2>&1; then
    echo "updating Release $REPO@$TAG"
  else
    echo "creating Release $REPO@$TAG"
    gh release create "$TAG" -R "$REPO" \
      --title "Website demo movies" \
      --notes "VP9 demo WebMs + captions + manifest for solid.express. Regenerated by scripts/sx-publish-demo-movies from the app repo. Replace assets with --clobber on each movie refresh."
  fi
  echo "uploading ${#assets[@]} assets to $REPO@$TAG"
  gh release upload "$TAG" -R "$REPO" --clobber "${assets[@]}"
  # gh upload can return before the Releases API lists every asset; the
  # trailing sx-check then false-fails (run 38918525777 saw 24/37 for ~2min).
  echo "waiting for Releases API to list all curated WebMs..."
  release_id="$(gh api "repos/$REPO/releases/tags/$TAG" --jq .id)"
  missing=("${IDS[@]}")
  deadline=$((SECONDS + 600))
  while (( SECONDS < deadline )); do
    mapfile -t listed < <(gh api "repos/$REPO/releases/$release_id/assets?per_page=100" --paginate --jq '.[].name')
    missing=()
    for id in "${IDS[@]}"; do
      found=0
      for n in "${listed[@]}"; do
        if [[ "$n" == "${id}.webm" ]]; then found=1; break; fi
      done
      if [[ $found -eq 0 ]]; then missing+=("${id}.webm"); fi
    done
    if [[ ${#missing[@]} -eq 0 ]]; then
      echo "Release listing has all ${#IDS[@]} curated WebMs (${#listed[@]} assets total)"
      break
    fi
    echo "  still missing ${#missing[@]} (${missing[*]}) — retry in 15s"
    sleep 15
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "sx-publish-demo-movies: Releases API still missing: ${missing[*]}" >&2
    exit 1
  fi
  if [[ "$CLI_IDS" -eq 0 ]]; then
    # Full curated publish: drop stale non-curated webms/posters/vtts.
    mapfile -t KEEP < <(curated_ids)
    keep_pat=$(printf '%s\n' "${KEEP[@]}")
    while IFS= read -r name; do
      [[ -z "$name" ]] && continue
      stem="${name%.*}"
      ext="${name##*.}"
      case "$ext" in
        webm|png|vtt) ;;
        *) continue ;;
      esac
      if ! grep -Fxq "$stem" <<<"$keep_pat"; then
        echo "deleting stale Release asset $name"
        gh release delete-asset "$TAG" "$name" -R "$REPO" --yes || true
      fi
    done < <(gh release view "$TAG" -R "$REPO" --json assets -q '.assets[].name')
  fi
else
  echo "SX_SKIP_UPLOAD=1: skipping gh release upload (${#assets[@]} assets)"
fi

emit_json

if [[ -z "${SX_POSTER_DIR:-}" ]]; then
  for id in "${IDS[@]}"; do
    src="$SHOTS/${id}.png"
    if [[ -f "$src" && "$src" != "$CANON_SHOTS/${id}.png" ]]; then
      mkdir -p "$CANON_SHOTS"
      cp -f "$src" "$CANON_SHOTS/${id}.png"
    fi
  done
fi

base="https://github.com/${REPO}/releases/download/${TAG}"
echo
echo "sx-publish-demo-movies: done"
echo "  posters → $SHOTS"
echo "  webms   → $base/<id>.webm"
echo "Commit poster PNG + published-demos.json + demo-catalog.json in the app repo."
echo "Do not commit .webm / .mp4 / .vtt — Release $TAG only."

default_pub="$ROOT/website/assets/published-demos.json"
if [[ -z "${SX_POSTER_DIR:-}" && "$PUBLISHED" == "$default_pub" && -x "$ROOT/scripts/sx-check-website-demos" ]]; then
  # Live Release listing was just verified above. Re-probing the same API/CDN
  # here false-fails for ~10+ minutes on a stale replica (runs 38918525777 and
  # 38925835622: wait saw 37 assets, check still listed 24 and CDN 404'd).
  # Offline still validates posters, published-demos, catalog, and HTML.
  "$ROOT/scripts/sx-check-website-demos" --offline
fi
