#!/usr/bin/env bash
# sx-publish-demo-movies — sync UI films to the marketing site without committing WebMs.
#
# Workflow:
#   1. make movies                         # → dist/movies/*.webm (+ .vtt)
#   2. scripts/sx-publish-demo-movies      # posters → github.io; WebMs → GitHub Release
#
# Posters (PNG) stay in solidexpress.github.io git for fast Pages loads.
# Full WebMs (+ VTT) live on a mutable GitHub Release tag (demo-movies) — not in git.
#
# Env overrides:
#   SX_MOVIES_OUT          default: <repo>/dist/movies
#   SX_SITE_ROOT           default: <repo>/../solidexpress.github.io
#   SX_DEMO_RELEASE_REPO   default: solidexpress/solidexpress.github.io
#   SX_DEMO_RELEASE_TAG    default: demo-movies
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${SX_MOVIES_OUT:-$ROOT/dist/movies}"
SITE="${SX_SITE_ROOT:-$ROOT/../solidexpress.github.io}"
# Host on the Pages repo so app-release subscribers are not notified.
REPO="${SX_DEMO_RELEASE_REPO:-solidexpress/solidexpress.github.io}"
TAG="${SX_DEMO_RELEASE_TAG:-demo-movies}"
MANIFEST="$ROOT/game/tests/ui_movie_manifest.json"

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "sx-publish-demo-movies: ffmpeg required" >&2
  exit 1
fi
if ! command -v gh >/dev/null 2>&1; then
  echo "sx-publish-demo-movies: gh CLI required" >&2
  exit 1
fi
if [[ ! -d "$SITE" ]]; then
  echo "sx-publish-demo-movies: site root not found: $SITE" >&2
  echo "  set SX_SITE_ROOT to your solidexpress.github.io checkout" >&2
  exit 1
fi
if [[ ! -f "$MANIFEST" ]]; then
  echo "sx-publish-demo-movies: missing $MANIFEST" >&2
  exit 1
fi

mapfile -t IDS < <(python3 - "$MANIFEST" <<'PY'
import json, sys
for e in json.load(open(sys.argv[1])):
    if e.get("enabled", True):
        print(e["id"])
PY
)

if [[ ${#IDS[@]} -eq 0 ]]; then
  echo "sx-publish-demo-movies: no enabled films in manifest" >&2
  exit 1
fi

SHOTS="$SITE/assets/screenshots"
mkdir -p "$SHOTS"

assets=()
for id in "${IDS[@]}"; do
  webm="$OUT/${id}.webm"
  vtt="$OUT/${id}.vtt"
  if [[ ! -f "$webm" ]]; then
    echo "sx-publish-demo-movies: missing $webm (run make movies first)" >&2
    exit 1
  fi
  poster="$SHOTS/${id}.png"
  echo "poster: $id → $poster"
  ffmpeg -y -loglevel error -sseof -0.1 -i "$webm" -frames:v 1 "$poster" </dev/null
  assets+=("$webm")
  if [[ -f "$vtt" ]]; then
    assets+=("$vtt")
  fi
done

# Drop committed WebMs / VTT from the Pages repo going forward (posters remain).
movies_dir="$SITE/assets/movies"
if [[ -d "$movies_dir" ]]; then
  shopt -s nullglob
  stale=("$movies_dir"/*.webm "$movies_dir"/*.vtt)
  if [[ ${#stale[@]} -gt 0 ]]; then
    echo "removing in-repo movie blobs from $movies_dir (hosted on Release $TAG instead)"
    rm -f "${stale[@]}"
  fi
  rmdir "$movies_dir" 2>/dev/null || true
fi

if gh release view "$TAG" -R "$REPO" >/dev/null 2>&1; then
  echo "updating Release $REPO@$TAG"
else
  echo "creating Release $REPO@$TAG"
  gh release create "$TAG" -R "$REPO" \
    --title "Website demo movies" \
    --notes "VP9 demo WebMs for solid.express. Regenerated by scripts/sx-publish-demo-movies from the app repo. Lives here (not on solidexpress/solidexpress) so app-release watchers are not notified. Replace assets with --clobber on each movie refresh."
fi

echo "uploading ${#assets[@]} assets to $REPO@$TAG"
gh release upload "$TAG" -R "$REPO" --clobber "${assets[@]}"

# Canonical site in this repo also gets posters + the published-id list so
# the marketing pages can never advertise a film that was not uploaded.
CANON_SHOTS="$ROOT/website/assets/screenshots"
mkdir -p "$CANON_SHOTS"
published_json="$ROOT/website/assets/published-demos.json"
python3 -c 'import json,sys; from pathlib import Path; p=Path(sys.argv[1]); ids=sys.argv[2:]; p.write_text(json.dumps(ids, indent=2)+"\n"); print(f"published-demos → {p} ({len(ids)} ids)")' \
  "$published_json" "${IDS[@]}"
for id in "${IDS[@]}"; do
  src="$SHOTS/${id}.png"
  if [[ -f "$src" ]]; then
    cp -f "$src" "$CANON_SHOTS/${id}.png"
  fi
done

base="https://github.com/${REPO}/releases/download/${TAG}"
echo
echo "sx-publish-demo-movies: done"
echo "  posters → $SHOTS and $CANON_SHOTS"
echo "  webms   → $base/<id>.webm"
echo "Commit and push poster PNG changes in $SITE."
echo "Also commit website/assets/published-demos.json + posters in the app repo."
echo "Do not commit .webm / .mp4 / .vtt to either git repo — Release $TAG only."
if [[ -x "$ROOT/scripts/sx-check-website-demos" ]]; then
  "$ROOT/scripts/sx-check-website-demos"
fi
