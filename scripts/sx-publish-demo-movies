#!/usr/bin/env bash
# sx-publish-demo-movies — sync UI films to the marketing site without committing WebMs.
#
# Workflow:
#   1. make movies                         # → dist/movies/*.webm (+ .vtt)
#   2. scripts/sx-publish-demo-movies      # posters → github.io; WebMs → GitHub Release
#
# With IDs: render nothing; require $SX_MOVIES_OUT/<id>.webm; extract poster;
# upload only those assets; append ids to website/assets/published-demos.json.
# --feature also appends {id,title,blurb} to demo-catalog.json featured.
# --dry-run prints those actions and writes nothing.
#
# Env overrides:
#   SX_MOVIES_OUT          default: <repo>/dist/movies
#   SX_SITE_ROOT           unused (no cross-repo writes)
#   SX_DEMO_RELEASE_REPO   default: solidexpress/solidexpress
#   SX_DEMO_RELEASE_TAG    default: demo-movies
#   SX_SKIP_UPLOAD         if set, skip gh release upload
#   SX_PUBLISHED_JSON      default: <repo>/website/assets/published-demos.json
#   SX_CATALOG_JSON        default: <repo>/website/assets/demo-catalog.json
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${SX_MOVIES_OUT:-$ROOT/dist/movies}"
REPO="${SX_DEMO_RELEASE_REPO:-solidexpress/solidexpress}"
TAG="${SX_DEMO_RELEASE_TAG:-demo-movies}"
MANIFEST="$ROOT/game/tests/ui_movie_manifest.json"
PUBLISHED="${SX_PUBLISHED_JSON:-$ROOT/website/assets/published-demos.json}"
CATALOG="${SX_CATALOG_JSON:-$ROOT/website/assets/demo-catalog.json}"
CANON_SHOTS="$ROOT/website/assets/screenshots"

DRY_RUN=0
FEATURE=0
IDS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --feature) FEATURE=1; shift ;;
    --) shift; break ;;
    -*)
      echo "sx-publish-demo-movies: unknown flag $1" >&2
      exit 2
      ;;
    *) IDS+=("$1"); shift ;;
  esac
done
while [[ $# -gt 0 ]]; do
  IDS+=("$1"); shift
done

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "sx-publish-demo-movies: ffmpeg required" >&2
  exit 1
fi
if [[ "$DRY_RUN" -eq 0 ]] && ! command -v gh >/dev/null 2>&1; then
  echo "sx-publish-demo-movies: gh CLI required" >&2
  exit 1
fi
if [[ ! -f "$MANIFEST" ]]; then
  echo "sx-publish-demo-movies: missing $MANIFEST" >&2
  exit 1
fi

if [[ ${#IDS[@]} -eq 0 ]]; then
  mapfile -t IDS < <(python3 - "$MANIFEST" <<'PY'
import json, sys
for e in json.load(open(sys.argv[1])):
    if e.get("enabled", True):
        print(e["id"])
PY
)
fi

if [[ ${#IDS[@]} -eq 0 ]]; then
  echo "sx-publish-demo-movies: no films to publish" >&2
  exit 1
fi

SHOTS="$CANON_SHOTS"
mkdir -p "$SHOTS" "$CANON_SHOTS"

assets=()
for id in "${IDS[@]}"; do
  webm="$OUT/${id}.webm"
  vtt="$OUT/${id}.vtt"
  if [[ ! -f "$webm" ]]; then
    echo "sx-publish-demo-movies: missing $webm (run make movies first)" >&2
    exit 1
  fi
  poster="$SHOTS/${id}.png"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "dry-run poster: $id → $poster"
  else
    echo "poster: $id → $poster"
    ffmpeg -y -loglevel error -sseof -0.1 -i "$webm" -frames:v 1 "$poster" </dev/null
  fi
  assets+=("$webm")
  assets+=("$poster")
  if [[ -f "$vtt" ]]; then
    assets+=("$vtt")
  fi
done
# Upload the manifest alongside media so the website can fetch it from the Release.
assets+=("$MANIFEST")

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "dry-run upload ${#assets[@]} assets to $REPO@$TAG: ${assets[*]}"
  python3 - "$PUBLISHED" "$CATALOG" "$MANIFEST" "$FEATURE" "${IDS[@]}" <<'PY'
import json, sys
from pathlib import Path
published_path, catalog_path, manifest_path, feature = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3]), sys.argv[4] == "1"
ids = sys.argv[5:]
have = json.loads(published_path.read_text()) if published_path.exists() else []
merged = sorted(set(have) | set(ids))
print(f"dry-run published-demos → {published_path} ({len(merged)} ids, append {ids})")
if feature:
    manifest = {e["id"]: e for e in json.load(open(manifest_path))}
    cat = json.loads(catalog_path.read_text())
    featured = list(cat.get("featured", []))
    have_ids = {row.get("id") for row in featured}
    for i in ids:
        if i in have_ids:
            continue
        entry = manifest.get(i, {})
        featured.append({
            "id": i,
            "title": entry.get("title", i),
            "blurb": entry.get("blurb", ""),
        })
        have_ids.add(i)
    print(f"dry-run demo-catalog featured append {ids} → {len(featured)} rows")
PY
  echo "dry-run: no gh call, no file change"
  exit 0
fi

if [[ "${SX_SKIP_UPLOAD:-}" == "" ]]; then
  if gh release view "$TAG" -R "$REPO" >/dev/null 2>&1; then
    echo "updating Release $REPO@$TAG"
  else
    echo "creating Release $REPO@$TAG"
    gh release create "$TAG" -R "$REPO" \
      --title "Website demo movies" \
      --notes "VP9 demo WebMs + captions + manifest for solid.express. Regenerated by scripts/sx-publish-demo-movies from the app repo. Replace assets with --clobber on each movie refresh."
  fi
  echo "uploading ${#assets[@]} assets to $REPO@$TAG"
  gh release upload "$TAG" -R "$REPO" --clobber "${assets[@]}"
else
  echo "SX_SKIP_UPLOAD=1: skipping gh release upload (${#assets[@]} assets)"
fi

if [[ ${#IDS[@]} -gt 0 ]]; then
  python3 - "$PUBLISHED" "$CATALOG" "$MANIFEST" "$FEATURE" "${IDS[@]}" <<'PY'
import json, sys
from pathlib import Path
published_path, catalog_path, manifest_path, feature = Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3]), sys.argv[4] == "1"
ids = sys.argv[5:]
have = json.loads(published_path.read_text()) if published_path.exists() else []
merged = sorted(set(str(x) for x in have) | set(ids))
published_path.write_text(json.dumps(merged, indent=2) + "\n")
print(f"published-demos → {published_path} ({len(merged)} ids)")
if feature:
    manifest = {e["id"]: e for e in json.load(open(manifest_path))}
    cat = json.loads(catalog_path.read_text())
    featured = list(cat.get("featured", []))
    have_ids = {row.get("id") for row in featured}
    for i in ids:
        if i in have_ids:
            continue
        entry = manifest.get(i, {})
        featured.append({
            "id": i,
            "title": entry.get("title", i),
            "blurb": entry.get("blurb", ""),
        })
        have_ids.add(i)
    cat["featured"] = featured
    catalog_path.write_text(json.dumps(cat, indent=2) + "\n")
    print(f"demo-catalog featured → {len(featured)} rows")
PY
else
  python3 -c 'import json,sys; from pathlib import Path; p=Path(sys.argv[1]); ids=sys.argv[2:]; p.write_text(json.dumps(ids, indent=2)+"\n"); print(f"published-demos → {p} ({len(ids)} ids)")' \
    "$PUBLISHED" "${IDS[@]}"
fi

for id in "${IDS[@]}"; do
  src="$SHOTS/${id}.png"
  if [[ -f "$src" && "$src" != "$CANON_SHOTS/${id}.png" ]]; then
    cp -f "$src" "$CANON_SHOTS/${id}.png"
  fi
done

base="https://github.com/${REPO}/releases/download/${TAG}"
echo
echo "sx-publish-demo-movies: done"
echo "  posters → $SHOTS and $CANON_SHOTS"
echo "  webms   → $base/<id>.webm"
echo "Commit and push poster PNG changes to the website Pages repo once (manual sync)."
echo "Also commit website/assets/published-demos.json + posters in the app repo."
echo "Do not commit .webm / .mp4 / .vtt to either git repo — Release $TAG only."
if [[ -x "$ROOT/scripts/sx-check-website-demos" ]]; then
  "$ROOT/scripts/sx-check-website-demos"
fi
